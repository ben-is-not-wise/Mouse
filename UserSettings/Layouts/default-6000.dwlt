        Title: 'Texture Atlas: Too much empty space'
        MessageFormat: Texture Atlas '{0}' has too much empty space ({1})
        DefaultSeverity: 4
        IsEnabledByDefault: 0
        Areas: 64
        Platforms: 
        Description: The texture atlas contains a lot of empty space. Empty space
